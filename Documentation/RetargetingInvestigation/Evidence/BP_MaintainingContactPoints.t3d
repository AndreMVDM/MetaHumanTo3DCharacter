      Begin Object Name="K2Node_MakeStruct_2" ExportPath="/Script/BlueprintGraph.K2Node_MakeStruct'/Game/ExampleContent/AnimationRetargeting/Blueprints/BP_MaintainingContactPoints.BP_MaintainingContactPoints:EventGraph.K2Node_MakeStruct_2'"
         bMadeAfterOverridePinRemoval=True
         ShowPinForProperties(0)=(PropertyName="TargetChainName",PropertyFriendlyName="Target Chain Name",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "RetargetIKChainSettings:TargetChainName", "The name of the TARGET chain to transfer animation onto."),CategoryName="Setup",bShowPin=True,bCanToggleVisibility=True)
         ShowPinForProperties(1)=(PropertyName="EnableIK",PropertyFriendlyName="Enable IK",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "RetargetIKChainSettings:EnableIK", "Whether to modify the location of the IK goal on this chain. Default is true.\nNOTE: This only has an effect if the chain has an IK Goal assigned to it in the Target IK Rig asset.\nNOTE: If off, and this chain has an IK Goal, the IK will still be evaluated, but the Goal is set to the input bone location (from the FK pass)."),CategoryName="Setup",bCanToggleVisibility=True)
         ShowPinForProperties(2)=(PropertyName="BlendToSource",PropertyFriendlyName="Blend to Source",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "RetargetIKChainSettings:BlendToSource", "Range 0 to 1. Default 0. Blends IK goal transform from retargeted transform (0) to source bone transform (1).\nAt 0 the goal is placed at the retargeted location and rotation.\nAt 1 the goal is placed at the location and rotation of the source chain\'s end bone."),CategoryName="Blend to Source",bShowPin=True,bCanToggleVisibility=True)
         ShowPinForProperties(3)=(PropertyName="BlendToSourceTranslation",PropertyFriendlyName="Blend to Source Translation",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "RetargetIKChainSettings:BlendToSourceTranslation", "Range 0 to 1. Default 1. Blends the translational component of BlendToSource on/off.\nAt 0 the goal is placed at the retargeted location.\nAt 1 the goal is placed at the location of the source chain\'s end bone."),CategoryName="Blend to Source",bCanToggleVisibility=True)
         ShowPinForProperties(4)=(PropertyName="BlendToSourceRotation",PropertyFriendlyName="Blend to Source Rotation",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "RetargetIKChainSettings:BlendToSourceRotation", "Range 0 to 1. Default 0. Blends the rotational component of BlendToSource on/off.\nAt 0 the goal is oriented to the retargeted rotation.\nAt 1 the goal is oriented to the source chain\'s end bone rotation."),CategoryName="Blend to Source",bCanToggleVisibility=True)
         ShowPinForProperties(5)=(PropertyName="BlendToSourceWeights",PropertyFriendlyName="Blend to Source Weights",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "RetargetIKChainSettings:BlendToSourceWeights", "Range 0 to 1. Default 1. Weight each axis separately when using Blend To Source.\nAt 0 the goal is placed at the retargeted location.\nAt 1 the goal is placed at the location of the source chain\'s end bone."),CategoryName="Blend to Source",bCanToggleVisibility=True)
         ShowPinForProperties(6)=(PropertyName="ApplyPelvisOffsetToSourceGoals",PropertyFriendlyName="Apply Pelvis Offset to Source Goals",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "RetargetIKChainSettings:ApplyPelvisOffsetToSourceGoals", "Default false. When true, the source goal locations are affected by the target pelvis motion.\nNOTE: this setting applies all offsets generated in the Pelvis Motion Op.\n      If no Pelvis Motion Op is present, or if the \"Affect IK\" weights in the Pelvis Motion Op are zero, then this setting has no effect."),CategoryName="Blend to Source",bShowPin=True,bCanToggleVisibility=True)
         ShowPinForProperties(7)=(PropertyName="StaticOffset",PropertyFriendlyName="Static Offset",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "RetargetIKChainSettings:StaticOffset", "Default 0, 0, 0. Apply a static global-space offset to IK goal position."),CategoryName="Static Offset",bCanToggleVisibility=True)
         ShowPinForProperties(8)=(PropertyName="StaticLocalOffset",PropertyFriendlyName="Static Local Offset",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "RetargetIKChainSettings:StaticLocalOffset", "Default 0, 0, 0. Apply a static local-space offset to IK goal position."),CategoryName="Static Offset",bCanToggleVisibility=True)
         ShowPinForProperties(9)=(PropertyName="StaticRotationOffset",PropertyFriendlyName="Static Rotation Offset",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "RetargetIKChainSettings:StaticRotationOffset", "Default 0, 0, 0. Apply a static local-space offset to IK goal rotation."),CategoryName="Static Offset",bCanToggleVisibility=True)
         ShowPinForProperties(10)=(PropertyName="ScaleVertical",PropertyFriendlyName="Scale Vertical",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "RetargetIKChainSettings:ScaleVertical", "Range 0 to infinity. Default 1. Scales the vertical component of the IK goal\'s position."),CategoryName="Scale Translation",bCanToggleVisibility=True)
         ShowPinForProperties(11)=(PropertyName="Extension",PropertyFriendlyName="Extension",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "RetargetIKChainSettings:Extension", "Range 0 to 5. Default 1. Brings IK goal closer (0) or further (1+) from origin of chain.\nAt 0 the effector is placed at the origin of the chain (ie Shoulder, Hip etc).\nAt 1 the effector is left at the end of the chain (ie Wrist, Foot etc)\nValues in-between 0-1 will slide the effector along the vector from the start to the end of the chain.\nValues greater than 1 will stretch the chain beyond the retargeted length."),CategoryName="Scale Length",bCanToggleVisibility=True)
         StructType="/Script/CoreUObject.ScriptStruct'/Script/IKRig.RetargetIKChainSettings'"
         NodePosX=1824
