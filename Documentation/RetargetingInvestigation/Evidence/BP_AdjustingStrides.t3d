         bMadeAfterOverridePinRemoval=True
         ShowPinForProperties(0)=(PropertyName="ChainSettings",PropertyFriendlyName="Chain Settings",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "IKRetargetStrideWarpingOpSettings:ChainSettings", "The chains to apply stride warping to"),CategoryName="Chains",bShowPin=True,bCanToggleVisibility=True)
         ShowPinForProperties(1)=(PropertyName="Alpha",PropertyFriendlyName="Alpha",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "IKRetargetStrideWarpingOpSettings:Alpha", "Range 0 to 1. Default 1. Blends the effect of all stride warping on/off. At 0, there is no effect."),CategoryName="Op Settings",bShowPin=True,bCanToggleVisibility=True)
         ShowPinForProperties(2)=(PropertyName="DirectionChain",PropertyFriendlyName="Direction Chain",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "IKRetargetStrideWarpingOpSettings:DirectionChain", "When using the \"Chain\" option as a Direction Source, this defines the chain to use to determine the facing direction of the character.\nTypically this would be the chain that contains the Spine bones."),CategoryName="Op Settings",bCanToggleVisibility=True)
         ShowPinForProperties(3)=(PropertyName="WarpForwards",PropertyFriendlyName="Warp Forwards",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "IKRetargetStrideWarpingOpSettings:WarpForwards", "Range 0 to Inf. Default 1. Warps IK goal positions in the forward direction. Useful for stride warping.\nValues below 1 will create smaller, squashed strides. Values greater than 1 will create stretched, longer strides."),CategoryName="Op Settings",bCanToggleVisibility=True)
         ShowPinForProperties(4)=(PropertyName="SidewaysOffset",PropertyFriendlyName="Sideways Offset",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "IKRetargetStrideWarpingOpSettings:SidewaysOffset", "Range -+Inf. Default is 0. A static offset in world units to move the IK goals perpendicular to the forward direction.\nValues less than zero will move the goals towards the center-line of the character. Values greater than zero push the goals outwards."),CategoryName="Op Settings",bCanToggleVisibility=True)
         ShowPinForProperties(5)=(PropertyName="WarpSplay",PropertyFriendlyName="Warp Splay",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "IKRetargetStrideWarpingOpSettings:WarpSplay", "Range 0 to +Inf. Default is 1.0f.\nValues below 1 pull all the goals towards the average of all the goals (towards each other).\nValues greater than 1 push the goals apart."),CategoryName="Op Settings",bShowPin=True,bCanToggleVisibility=True)
         ShowPinForProperties(6)=(PropertyName="DebugDrawSize",PropertyFriendlyName="Debug Draw Size",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "IKRetargetStrideWarpingOpSettings:DebugDrawSize", "Adjust the size of the debug drawing"),CategoryName="Debug",bCanToggleVisibility=True)
         ShowPinForProperties(7)=(PropertyName="DebugDrawThickness",PropertyFriendlyName="Debug Draw Thickness",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "IKRetargetStrideWarpingOpSettings:DebugDrawThickness", "Adjust the thickness of the debug drawing"),CategoryName="Debug",bCanToggleVisibility=True)
         ShowPinForProperties(8)=(PropertyName="bEnabled",PropertyFriendlyName="Enabled",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "IKRetargetOpSettingsBase:bEnabled", "Enable/disable the entire operation. Disabled ops are skipped entirely and do not run at all."),CategoryName="Enable Op",bShowPin=True,bCanToggleVisibility=True)
         ShowPinForProperties(9)=(PropertyName="LODThreshold",PropertyFriendlyName="LODThreshold",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "IKRetargetOpSettingsBase:LODThreshold", "The maximum LOD that this Op is allowed to run at.\nFor example if you have LODThreshold of 2, the Op will run until LOD 2 (based on 0 index). When the component LOD becomes 3, it will stop running.\nA value of -1 forces the Op to execute at all LOD levels. Default is -1."),CategoryName="Level of Detail",bShowPin=True,bCanToggleVisibility=True)
