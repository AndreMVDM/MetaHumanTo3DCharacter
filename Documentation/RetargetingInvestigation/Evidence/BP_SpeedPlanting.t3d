      Begin Object Name="K2Node_MakeStruct_9" ExportPath="/Script/BlueprintGraph.K2Node_MakeStruct'/Game/ExampleContent/AnimationRetargeting/Blueprints/BP_SpeedPlanting.BP_SpeedPlanting:EventGraph.K2Node_MakeStruct_9'"
         bMadeAfterOverridePinRemoval=True
         ShowPinForProperties(0)=(PropertyName="ChainsToSpeedPlant",PropertyFriendlyName="Chains to Speed Plant",CategoryName="Chains",bShowPin=True,bCanToggleVisibility=True)
         ShowPinForProperties(1)=(PropertyName="Alpha",PropertyFriendlyName="Alpha",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "IKRetargetSpeedPlantingOpSettings:Alpha", "Range 0 to 1. Default 1. Blends the effect of the speed planting. At 0, there is no effect."),CategoryName="Op Settings",bShowPin=True,bCanToggleVisibility=True)
         ShowPinForProperties(2)=(PropertyName="SpeedThreshold",PropertyFriendlyName="Speed Threshold",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "IKRetargetSpeedPlantingOpSettings:SpeedThreshold", "Range 0 to 100. Default 15. The maximum speed a source bone can be moving while being considered \'planted\'.\nThe target IK goal will not be allowed to move whenever the source bone speed drops below this threshold speed."),CategoryName="Op Settings",bShowPin=True,bCanToggleVisibility=True)
         ShowPinForProperties(3)=(PropertyName="BlendMethod",PropertyFriendlyName="Blend Method",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "IKRetargetSpeedPlantingOpSettings:BlendMethod", "The method to use when blending the IK goal in/out of a planted position.\nThe Spring method uses a critically damped spring equation to blend into and out of the planted states.\nThe Move Towards method can more accurately track fast motion without looking mushy. It only blends out of planted states."),CategoryName="Op Settings",bShowPin=True,bCanToggleVisibility=True)
         ShowPinForProperties(4)=(PropertyName="MaxBlendSpeed",PropertyFriendlyName="Max Blend Speed",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "IKRetargetSpeedPlantingOpSettings:MaxBlendSpeed", "The maximum speed in cm/s that the goal will move to catch up to the animation after unplanting. This blended towards the animated velocity\nas the goal catches up to animated location after unplanting."),CategoryName="Op Settings",bShowPin=True,bCanToggleVisibility=True)
         ShowPinForProperties(5)=(PropertyName="TimeToMaxSpeed",PropertyFriendlyName="Time to Max Speed",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "IKRetargetSpeedPlantingOpSettings:TimeToMaxSpeed", "Seconds to reach MaxBlendSpeed. Determines how rapidly the goal accelerates after unplanting."),CategoryName="Op Settings",bShowPin=True,bCanToggleVisibility=True)
         ShowPinForProperties(6)=(PropertyName="ArrivalSpeedGain",PropertyFriendlyName="Arrival Speed Gain",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "IKRetargetSpeedPlantingOpSettings:ArrivalSpeedGain", "Controls how aggressively the goal velocity matches the animated velocity as it arrives at the animated location after unplanting.\nThis allows the goal speed to gradually blend towards the target speed as the goal location approaches the animated location.\nReduce this to remove velocity discontinuities when catching up to the animation.\n1.0 is very soft, 20.0 is very sharp. Default is 10.0."),CategoryName="Op Settings",bShowPin=True,bCanToggleVisibility=True)
         ShowPinForProperties(7)=(PropertyName="SpringStrength",PropertyFriendlyName="Spring Strength",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "IKRetargetSpeedPlantingOpSettings:SpringStrength", "The spring strength determines how hard it will pull towards the target when planting and unplanting.\nThe value is the frequency (hz) at which it will oscillate when there is no damping."),CategoryName="Op Settings",bShowPin=True,bCanToggleVisibility=True)
         ShowPinForProperties(8)=(PropertyName="DebugDrawSize",PropertyFriendlyName="Debug Draw Size",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "IKRetargetSpeedPlantingOpSettings:DebugDrawSize", "Adjust size of goal debug drawing in viewport. Red is planted, green is unplanted."),CategoryName="Debug",bShowPin=True,bCanToggleVisibility=True)
         ShowPinForProperties(9)=(PropertyName="bEnabled",PropertyFriendlyName="Enabled",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "IKRetargetOpSettingsBase:bEnabled", "Enable/disable the entire operation. Disabled ops are skipped entirely and do not run at all."),CategoryName="Enable Op",bShowPin=True,bCanToggleVisibility=True)
         ShowPinForProperties(10)=(PropertyName="LODThreshold",PropertyFriendlyName="LODThreshold",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "IKRetargetOpSettingsBase:LODThreshold", "The maximum LOD that this Op is allowed to run at.\nFor example if you have LODThreshold of 2, the Op will run until LOD 2 (based on 0 index). When the component LOD becomes 3, it will stop running.\nA value of -1 forces the Op to execute at all LOD levels. Default is -1."),CategoryName="Level of Detail",bShowPin=True,bCanToggleVisibility=True)
