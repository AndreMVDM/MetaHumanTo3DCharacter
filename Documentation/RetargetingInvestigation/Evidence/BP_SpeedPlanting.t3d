         CustomProperties Pin (PinId=31D2CDA344D24D985F125CB3CB5F35BA,PinName="Alpha",PinFriendlyName=INVTEXT("Alpha"),PinToolTip="Alpha\nFloat (single-precision)\n\nRange 0 to 1. Default 1. Blends the effect of the speed planting. At 0, there is no effect.",PinType.PinCategory="real",PinType.PinSubCategory="float",PinType.PinSubCategoryObject=None,PinType.PinSubCategoryMemberReference=(),PinType.PinValueType=(),PinType.ContainerType=None,PinType.bIsReference=False,PinType.bIsConst=False,PinType.bIsWeakPointer=False,PinType.bIsUObjectWrapper=False,PinType.bSerializeAsSinglePrecisionFloat=False,DefaultValue="1.000000",AutogeneratedDefaultValue="1.000000",PersistentGuid=00000000000000000000000000000000,bHidden=False,bNotConnectable=False,bDefaultValueIsReadOnly=False,bDefaultValueIsIgnored=False,bAdvancedView=False,bOrphanedPin=False,)
         CustomProperties Pin (PinId=406501DC4AA06D4CAA1822BFE52963B3,PinName="SpeedThreshold",PinFriendlyName=INVTEXT("Speed Threshold"),PinToolTip="Speed Threshold\nFloat (double-precision)\n\nRange 0 to 100. Default 15. The maximum speed a source bone can be moving while being considered \'planted\'.\nThe target IK goal will not be allowed to move whenever the source bone speed drops below this threshold speed.",PinType.PinCategory="real",PinType.PinSubCategory="double",PinType.PinSubCategoryObject=None,PinType.PinSubCategoryMemberReference=(),PinType.PinValueType=(),PinType.ContainerType=None,PinType.bIsReference=False,PinType.bIsConst=False,PinType.bIsWeakPointer=False,PinType.bIsUObjectWrapper=False,PinType.bSerializeAsSinglePrecisionFloat=False,DefaultValue="15.000000",AutogeneratedDefaultValue="15.000000",PersistentGuid=00000000000000000000000000000000,bHidden=False,bNotConnectable=False,bDefaultValueIsReadOnly=False,bDefaultValueIsIgnored=False,bAdvancedView=True,bOrphanedPin=False,)
         CustomProperties Pin (PinId=8BB2C03942F2DB6074A0F98E26122FA2,PinName="BlendMethod",PinFriendlyName=INVTEXT("Blend Method"),PinToolTip="Blend Method\nESpeedPlantBlendMethod Enum\n\nThe method to use when blending the IK goal in/out of a planted position.\nThe Spring method uses a critically damped spring equation to blend into and out of the planted states.\nThe Move Towards method can more accurately track fast motion without looking mushy. It only blends out of planted states.",PinType.PinCategory="byte",PinType.PinSubCategory="",PinType.PinSubCategoryObject="/Script/CoreUObject.Enum'/Script/IKRig.ESpeedPlantBlendMethod'",PinType.PinSubCategoryMemberReference=(),PinType.PinValueType=(),PinType.ContainerType=None,PinType.bIsReference=False,PinType.bIsConst=False,PinType.bIsWeakPointer=False,PinType.bIsUObjectWrapper=False,PinType.bSerializeAsSinglePrecisionFloat=False,DefaultValue="Spring",AutogeneratedDefaultValue="Spring",PersistentGuid=00000000000000000000000000000000,bHidden=False,bNotConnectable=False,bDefaultValueIsReadOnly=False,bDefaultValueIsIgnored=False,bAdvancedView=True,bOrphanedPin=False,)
         CustomProperties Pin (PinId=82FEB7DF4F775D84B9BDC092AF38E1FB,PinName="MaxBlendSpeed",PinFriendlyName=INVTEXT("Max Blend Speed"),PinToolTip="Max Blend Speed\nFloat (double-precision)\n\nThe maximum speed in cm/s that the goal will move to catch up to the animation after unplanting. This blended towards the animated velocity\nas the goal catches up to animated location after unplanting.",PinType.PinCategory="real",PinType.PinSubCategory="double",PinType.PinSubCategoryObject=None,PinType.PinSubCategoryMemberReference=(),PinType.PinValueType=(),PinType.ContainerType=None,PinType.bIsReference=False,PinType.bIsConst=False,PinType.bIsWeakPointer=False,PinType.bIsUObjectWrapper=False,PinType.bSerializeAsSinglePrecisionFloat=False,DefaultValue="900.000000",AutogeneratedDefaultValue="900.000000",PersistentGuid=00000000000000000000000000000000,bHidden=False,bNotConnectable=False,bDefaultValueIsReadOnly=False,bDefaultValueIsIgnored=False,bAdvancedView=True,bOrphanedPin=False,)
         CustomProperties Pin (PinId=1E7D80D24728A480E00DC58C7DDB3E75,PinName="TimeToMaxSpeed",PinFriendlyName=INVTEXT("Time to Max Speed"),PinToolTip="Time To Max Speed\nFloat (double-precision)\n\nSeconds to reach MaxBlendSpeed. Determines how rapidly the goal accelerates after unplanting.",PinType.PinCategory="real",PinType.PinSubCategory="double",PinType.PinSubCategoryObject=None,PinType.PinSubCategoryMemberReference=(),PinType.PinValueType=(),PinType.ContainerType=None,PinType.bIsReference=False,PinType.bIsConst=False,PinType.bIsWeakPointer=False,PinType.bIsUObjectWrapper=False,PinType.bSerializeAsSinglePrecisionFloat=False,DefaultValue="0.200000",AutogeneratedDefaultValue="0.200000",PersistentGuid=00000000000000000000000000000000,bHidden=False,bNotConnectable=False,bDefaultValueIsReadOnly=False,bDefaultValueIsIgnored=False,bAdvancedView=True,bOrphanedPin=False,)
         CustomProperties Pin (PinId=C296787B468BC6B5065E57B8119093D9,PinName="ArrivalSpeedGain",PinFriendlyName=INVTEXT("Arrival Speed Gain"),PinToolTip="Arrival Speed Gain\nFloat (double-precision)\n\nControls how aggressively the goal velocity matches the animated velocity as it arrives at the animated location after unplanting.\nThis allows the goal speed to gradually blend towards the target speed as the goal location approaches the animated location.\nReduce this to remove velocity discontinuities when catching up to the animation.\n1.0 is very soft, 20.0 is very sharp. Default is 10.0.",PinType.PinCategory="real",PinType.PinSubCategory="double",PinType.PinSubCategoryObject=None,PinType.PinSubCategoryMemberReference=(),PinType.PinValueType=(),PinType.ContainerType=None,PinType.bIsReference=False,PinType.bIsConst=False,PinType.bIsWeakPointer=False,PinType.bIsUObjectWrapper=False,PinType.bSerializeAsSinglePrecisionFloat=False,DefaultValue="10.000000",AutogeneratedDefaultValue="10.000000",PersistentGuid=00000000000000000000000000000000,bHidden=False,bNotConnectable=False,bDefaultValueIsReadOnly=False,bDefaultValueIsIgnored=False,bAdvancedView=True,bOrphanedPin=False,)
         CustomProperties Pin (PinId=989794DD49D7AF39029DD5A5B71123D5,PinName="SpringStrength",PinFriendlyName=INVTEXT("Spring Strength"),PinToolTip="Spring Strength\nFloat (double-precision)\n\nThe spring strength determines how hard it will pull towards the target when planting and unplanting.\nThe value is the frequency (hz) at which it will oscillate when there is no damping.",PinType.PinCategory="real",PinType.PinSubCategory="double",PinType.PinSubCategoryObject=None,PinType.PinSubCategoryMemberReference=(),PinType.PinValueType=(),PinType.ContainerType=None,PinType.bIsReference=False,PinType.bIsConst=False,PinType.bIsWeakPointer=False,PinType.bIsUObjectWrapper=False,PinType.bSerializeAsSinglePrecisionFloat=False,DefaultValue="3.000000",AutogeneratedDefaultValue="3.000000",PersistentGuid=00000000000000000000000000000000,bHidden=False,bNotConnectable=False,bDefaultValueIsReadOnly=False,bDefaultValueIsIgnored=False,bAdvancedView=True,bOrphanedPin=False,)
         CustomProperties Pin (PinId=7ACA9F0B403FCDF2EB55229E286F9AE1,PinName="DebugDrawSize",PinFriendlyName=INVTEXT("Debug Draw Size"),PinToolTip="Debug Draw Size\nFloat (double-precision)\n\nAdjust size of goal debug drawing in viewport. Red is planted, green is unplanted.",PinType.PinCategory="real",PinType.PinSubCategory="double",PinType.PinSubCategoryObject=None,PinType.PinSubCategoryMemberReference=(),PinType.PinValueType=(),PinType.ContainerType=None,PinType.bIsReference=False,PinType.bIsConst=False,PinType.bIsWeakPointer=False,PinType.bIsUObjectWrapper=False,PinType.bSerializeAsSinglePrecisionFloat=False,DefaultValue="5.000000",AutogeneratedDefaultValue="5.000000",PersistentGuid=00000000000000000000000000000000,bHidden=False,bNotConnectable=False,bDefaultValueIsReadOnly=False,bDefaultValueIsIgnored=False,bAdvancedView=True,bOrphanedPin=False,)
