      Begin Object Name="K2Node_SetFieldsInStruct_1" ExportPath="/Script/BlueprintGraph.K2Node_SetFieldsInStruct'/Game/ExampleContent/AnimationRetargeting/Blueprints/BP_EditingRetargetRoot.BP_EditingRetargetRoot:EventGraph.K2Node_SetFieldsInStruct_1'"
         bMadeAfterOverridePinRemoval=True
         ShowPinForProperties(0)=(PropertyName="BlendToAbsoluteOffset",PropertyFriendlyName="Blend to Absolute Offset",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "IKRetargetPelvisMotionOpSettings:BlendToAbsoluteOffset", "Blend from motion scaled by the size of the character, to the absolute delta motion from the source.\nNOTE: Typically, this is only applied to vertical motion (Z) to prevent dampening the pelvis bob on short characters."),CategoryName="Scaled or Absolute",bCanToggleVisibility=True)
         ShowPinForProperties(1)=(PropertyName="FloorConstraintWeight",PropertyFriendlyName="Floor Constraint Weight",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "IKRetargetPelvisMotionOpSettings:FloorConstraintWeight", "Range 0 to 1. Default is 0. Set to a value of 1 to turn the pelvis floor constraint ON.\nWhen ON, the floor constraint will adjust the vertical Pelvis motion separately according to the following rules:\n1. When the source pelvis is LOWER than the ref pose, the target pelvis will be lowered proportional to their relative crotch heights.\n2. When the source pelvis is HIGHER than the ref pose, the target pelvis will be raised an identical amount while maintaining any vertical offset in the ref pose."),CategoryName="Floor Constraint",bCanToggleVisibility=True)
         ShowPinForProperties(2)=(PropertyName="SourceCrotchOffset",PropertyFriendlyName="Source Crotch Offset",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "IKRetargetPelvisMotionOpSettings:SourceCrotchOffset", "A negative vertical offset in cm relative to the Pelvis bone of the SOURCE.\nNOTE: Adjust this until the green dot is located roughly at the crotch of the character."),CategoryName="Floor Constraint",bCanToggleVisibility=True)
         ShowPinForProperties(3)=(PropertyName="TargetCrotchOffset",PropertyFriendlyName="Target Crotch Offset",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "IKRetargetPelvisMotionOpSettings:TargetCrotchOffset", "A negative vertical offset in cm relative to the Pelvis bone of the TARGET.\nNOTE: Adjust this until the green dot is located roughly at the crotch of the character."),CategoryName="Floor Constraint",bCanToggleVisibility=True)
         ShowPinForProperties(4)=(PropertyName="bUseGroundFalloff",PropertyFriendlyName="Use Ground Falloff",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "IKRetargetPelvisMotionOpSettings:bUseGroundFalloff", "When true, the effect of the floor constraint decays as the pelvis gets further from the floor.\nNOTE: This can help avoid over dampening vertical motion on the pelvis when retargeting to characters that are shorter than the source."),CategoryName="Floor Constraint",bCanToggleVisibility=True)
         ShowPinForProperties(5)=(PropertyName="GroundFalloffHeightPercent",PropertyFriendlyName="Ground Falloff Height Percent",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "IKRetargetPelvisMotionOpSettings:GroundFalloffHeightPercent", "Controls the height at which the floor constraint will begin blending in as a percentage of the pelvis height in the retarget pose.\nNOTE: Use this to prevent the floor constraint from dampening vertical pelvis motion at normal standing heights.\nAt 1, the constraint is active at normal standing height. At 0.1, the constraint will only activate when within 10% of the height off the floor."),CategoryName="Floor Constraint",bCanToggleVisibility=True)
         ShowPinForProperties(6)=(PropertyName="RotationAlpha",PropertyFriendlyName="Rotation Alpha",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "IKRetargetPelvisMotionOpSettings:RotationAlpha", "Range 0 to 1. Default 1. Blends the amount of retargeted pelvis rotation to apply.\nAt 0 the pelvis is left at the rotation from the retarget pose.\nAt 1 the pelvis is rotated fully to match the source pelvis rotation."),CategoryName="Pelvis Rotation",bCanToggleVisibility=True)
         ShowPinForProperties(7)=(PropertyName="RotationOffsetLocal",PropertyFriendlyName="Rotation Offset Local",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "IKRetargetPelvisMotionOpSettings:RotationOffsetLocal", "Applies a static local-space rotation offset to the pelvis."),CategoryName="Pelvis Rotation",bCanToggleVisibility=True)
         ShowPinForProperties(8)=(PropertyName="RotationOffsetGlobal",PropertyFriendlyName="Rotation Offset Global",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "IKRetargetPelvisMotionOpSettings:RotationOffsetGlobal", "Applies a static global-space rotation offset to the pelvis."),CategoryName="Pelvis Rotation",bCanToggleVisibility=True)
         ShowPinForProperties(9)=(PropertyName="TranslationAlpha",PropertyFriendlyName="Translation Alpha",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "IKRetargetPelvisMotionOpSettings:TranslationAlpha", "Range 0 to 1. Default 1. Blends the amount of retargeted pelvis translation to apply.\nAt 0 the pelvis is left at the position from the retarget pose.\nAt 1 the pelvis will follow the source motion according to the behavior defined in the subsequent settings."),CategoryName="Pelvis Translation",bCanToggleVisibility=True)
         ShowPinForProperties(10)=(PropertyName="TranslationOffsetLocal",PropertyFriendlyName="Translation Offset Local",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "IKRetargetPelvisMotionOpSettings:TranslationOffsetLocal", "Applies a static local-space translation offset to the pelvis."),CategoryName="Pelvis Translation",bCanToggleVisibility=True)
         ShowPinForProperties(11)=(PropertyName="TranslationOffsetGlobal",PropertyFriendlyName="Translation Offset Global",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "IKRetargetPelvisMotionOpSettings:TranslationOffsetGlobal", "Applies a static global-space translation offset to the pelvis."),CategoryName="Pelvis Translation",bShowPin=True,bCanToggleVisibility=True)
         ShowPinForProperties(12)=(PropertyName="BlendToSourceTranslation",PropertyFriendlyName="Blend to Source Translation",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "IKRetargetPelvisMotionOpSettings:BlendToSourceTranslation", "Range 0 to 1. Default 0. Blends the retarget pelvis\' translation to the exact source location.\nAt 0 the pelvis is placed at the retargeted location.\nAt 1 the pelvis is placed at the location of the source\'s pelvis bone."),CategoryName="Pelvis Translation",bCanToggleVisibility=True)
         ShowPinForProperties(13)=(PropertyName="BlendToSourceTranslationWeights",PropertyFriendlyName="Blend to Source Translation Weights",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "IKRetargetPelvisMotionOpSettings:BlendToSourceTranslationWeights", "Per-axis weights for the Blend to Source."),CategoryName="Pelvis Translation",bCanToggleVisibility=True)
         ShowPinForProperties(14)=(PropertyName="ScaleHorizontal",PropertyFriendlyName="Scale Horizontal",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "IKRetargetPelvisMotionOpSettings:ScaleHorizontal", "Default 1. Scales the translation of the pelvis in the horizontal plane (X,Y)."),CategoryName="Scale Pelvis Translation",bCanToggleVisibility=True)
         ShowPinForProperties(15)=(PropertyName="ScaleVertical",PropertyFriendlyName="Scale Vertical",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "IKRetargetPelvisMotionOpSettings:ScaleVertical", "Default 1. Scales the translation of the pelvis in the vertical direction (Z)."),CategoryName="Scale Pelvis Translation",bCanToggleVisibility=True)
         ShowPinForProperties(16)=(PropertyName="AffectIKHorizontal",PropertyFriendlyName="Affect IK Horizontal",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "IKRetargetPelvisMotionOpSettings:AffectIKHorizontal", "Range 0 to 1. Default 1. Control whether modifications made to the pelvis will affect the horizontal component of IK positions.\nAt 0 the IK positions are independent of the pelvis modifications.\nAt 1 the IK positions are calculated relative to the modified pelvis location."),CategoryName="Affect IK Settings",bCanToggleVisibility=True)
         ShowPinForProperties(17)=(PropertyName="AffectIKVertical",PropertyFriendlyName="Affect IK Vertical",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "IKRetargetPelvisMotionOpSettings:AffectIKVertical", "Range 0 to 1. Default 0. Control whether modifications made to the pelvis will affect the vertical component of IK positions.\nAt 0 the IK positions are independent of the pelvis modifications.\nAt 1 the IK positions are calculated relative to the modified pelvis location."),CategoryName="Affect IK Settings",bCanToggleVisibility=True)
         ShowPinForProperties(18)=(PropertyName="DebugDrawSize",PropertyFriendlyName="Debug Draw Size",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "IKRetargetPelvisMotionOpSettings:DebugDrawSize", "Adjust size of the debug drawing"),CategoryName="Debug",bCanToggleVisibility=True)
         ShowPinForProperties(19)=(PropertyName="DebugDrawThickness",PropertyFriendlyName="Debug Draw Thickness",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "IKRetargetPelvisMotionOpSettings:DebugDrawThickness", "Adjust thickness of the debug drawing"),CategoryName="Debug",bCanToggleVisibility=True)
         ShowPinForProperties(20)=(PropertyName="bEnabled",PropertyFriendlyName="Enabled",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "IKRetargetOpSettingsBase:bEnabled", "Enable/disable the entire operation. Disabled ops are skipped entirely and do not run at all."),CategoryName="Enable Op",bCanToggleVisibility=True)
         ShowPinForProperties(21)=(PropertyName="LODThreshold",PropertyFriendlyName="LODThreshold",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "IKRetargetOpSettingsBase:LODThreshold", "The maximum LOD that this Op is allowed to run at.\nFor example if you have LODThreshold of 2, the Op will run until LOD 2 (based on 0 index). When the component LOD becomes 3, it will stop running.\nA value of -1 forces the Op to execute at all LOD levels. Default is -1."),CategoryName="Level of Detail",bCanToggleVisibility=True)
